@@ -0,0 +1,62 @@
+package mock
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// SendMediaGroup supports photo/video albums sent with existing file IDs.
+func (h *Handlers) SendMediaGroup(c *gin.Context, bot *botEntry) {
+	body, err := readBody(c)
+	if err != nil {
+		errResp(c, http.StatusBadRequest, "Bad Request: "+err.Error())
+		return
+	}
+	chatID := toInt64(body["chat_id"])
+	if chatID == 0 {
+		errResp(c, http.StatusBadRequest, "Bad Request: chat_id is required")
+		return
+	}
+
+	data, err := json.Marshal(body["media"])
+	if text, ok := body["media"].(string); ok {
+		data = []byte(text)
+	}
+	var media []struct {
+		Type    string `json:"type"`
+		Media   string `json:"media"`
+		Caption string `json:"caption"`
+	}
+	if err != nil || json.Unmarshal(data, &media) != nil || len(media) < 2 || len(media) > 10 {
+		errResp(c, http.StatusBadRequest, "Bad Request: media must contain 2 to 10 items")
+		return
+	}
+	// Validate the whole album before storing any messages.
+	for _, item := range media {
+		if (item.Type != "photo" && item.Type != "video") || item.Media == "" || strings.Contains(item.Media, "://") {
+			errResp(c, http.StatusBadRequest, "Bad Request: only photo/video file IDs are supported")
+			return
+		}
+	}
+
+	groupID := strconv.FormatInt(h.Store.NextEventSeq(), 10)
+	messages := make([]Message, 0, len(media))
+	for _, item := range media {
+		message := h.newBotMessage(bot, chatID)
+		message.MediaGroupID = groupID
+		message.Caption = item.Caption
+		setMessageThread(&message, body)
+		if item.Type == "photo" {
+			message.Photo = []PhotoSize{{FileID: item.Media, FileUniqueID: item.Media + "_u", Width: 1, Height: 1}}
+		} else {
+			message.Video = &Video{FileID: item.Media, FileUniqueID: item.Media + "_u", Width: 1, Height: 1, Duration: 1}
+		}
+		bot.AppendMessage(message)
+		messages = append(messages, message)
+	}
+	c.JSON(http.StatusOK, APIResponse{OK: true, Result: messages})
+}
